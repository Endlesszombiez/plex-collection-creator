# Database location (defaults to ./data/plex-collections.db)
DATABASE_URL=./data/plex-collections.db

# Encryption key for storing sensitive data (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# AI Provider credentials (configure one)
# Anthropic
ANTHROPIC_API_KEY=

# Amazon Bedrock (uses AWS credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Google Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=

# LM Studio Local Server
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_MODEL=
LMSTUDIO_FAST_MODEL=
LMSTUDIO_API_KEY=lm-studio

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
